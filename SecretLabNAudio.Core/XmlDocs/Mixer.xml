<?xml version="1.0" encoding="utf-8"?>
<doc>
    <Add>
        <Anonymous>
            <param name="input">The sample provider.</param>
            <param name="isOwned">Whether to dispose of the provider when the input is removed or when this mixer is disposed.</param>
        </Anonymous>
        <Named>
            <param name="input">The sample provider.</param>
            <param name="name">The name of the input.</param>
            <param name="isOwned">Whether to dispose of the provider when the input is removed or when this mixer is disposed.</param>
        </Named>
        <exception cref="T:System.ArgumentException">
            Thrown if the<paramref name="input" />'s sample rate or channels differ from the
            <see cref="P:SecretLabNAudio.Core.Processors.Mixer.WaveFormat" />
            of this instance.
        </exception>
    </Add>
    <AddProcess>
        <exception cref="T:System.ArgumentException">
            Thrown if the processed input's sample rate or channels differ from the
            <see cref="P:SecretLabNAudio.Core.Processors.Mixer.WaveFormat" />
            of the mixer.
        </exception>
    </AddProcess>
    <AddClip>
        <exception cref="T:System.ArgumentException">
            Thrown if the mixer's
            <see cref="P:SecretLabNAudio.Core.Processors.Mixer.WaveFormat" />
            is not <see cref="P:SecretLabNAudio.Core.AudioPlayer.SupportedFormat">player-compatible</see>.
        </exception>
    </AddClip>
    <Player>
        <remarks>
            If the
            <see cref="P:SecretLabNAudio.Core.AudioPlayer.SampleProvider" />
            is not a mixer, it will be replaced with one.
            The existing provider (if present) will be added as an anonymous mixer input.
        </remarks>
    </Player>
    <RemoveAllByName>
        <summary>Removes all inputs whose
            <see cref="P:SecretLabNAudio.Core.Processors.MixerInput.Name" />
            equals
            <paramref name="name" />.
        </summary>
        <remarks>
            If
            <paramref name="ignoreCase" />
            is
            <see langword="true" />,
            <see cref="F:System.StringComparison.OrdinalIgnoreCase" />
            is used; otherwise,
            <see cref="F:System.StringComparison.Ordinal" />
            is used.
        </remarks>
    </RemoveAllByName>
    <RemoveAllShortClips>
        <summary>
            Removes all mixer inputs whose source is a
            <see cref="T:SecretLabNAudio.Core.Providers.RawSourceSampleProvider" />.
        </summary>
    </RemoveAllShortClips>
    <Use>
        <summary>
            Sets the
            <see cref="P:SecretLabNAudio.Core.AudioPlayer.SampleProvider" />
            to a
            <see cref="T:SecretLabNAudio.Core.Processors.Mixer" />.
        </summary>
        <remarks>
            If
            <paramref name="keepInputs" />
            is false: a new
            <see cref="Mixer" />
            will be created.
            <br />
            If
            <paramref name="keepInputs" />
            is true, and the current provider is a
            <see cref="T:SecretLabNAudio.Core.Processors.Mixer" />: nothing happens.
            <br />
            If
            <paramref name="keepInputs" />
            is true, and the current provider is not a
            <see cref="T:SecretLabNAudio.Core.Processors.Mixer" />: the provider is set to a new mixer,
            and if the provider is set, the provider is added as an anonymous input with an ownership equivalent to
            <see cref="P:SecretLabNAudio.Core.AudioPlayer.OwnsProvider" />.
        </remarks>
    </Use>
</doc>
