<?xml version="1.0" encoding="utf-8"?>
<doc>
    <Add>
        <param name="input">The sample provider.</param>
        <param name="isOwned">Whether to dispose of the provider when it ends or when this queue is disposed.</param>
        <exception cref="T:System.ArgumentException">
            Thrown if the<paramref name="input" />'s sample rate or channels differ from the
            <see cref="P:SecretLabNAudio.Core.Processors.AudioQueue.WaveFormat" />
            of this instance.
        </exception>
    </Add>
    <AddProcess>
        <exception cref="T:System.ArgumentException">
            Thrown if the processed input's sample rate or channels differ from the
            <see cref="P:SecretLabNAudio.Core.Processors.AudioQueue.WaveFormat" />
            of the queue.
        </exception>
    </AddProcess>
    <AddClip>
        <exception cref="T:System.ArgumentException">
            Thrown if the queue's
            <see cref="P:SecretLabNAudio.Core.Processors.AudioQueue.WaveFormat" />
            is not <see cref="P:SecretLabNAudio.Core.AudioPlayer.SupportedFormat">player-compatible</see>.
        </exception>
    </AddClip>
    <Player>
        <remarks>
            If the
            <see cref="M:SecretLabNAudio.Core.Extensions.AudioPlayerExtensions.SingleInputAs``1(SecretLabNAudio.Core.AudioPlayer)">single input</see>
            is not an
            <see cref="T:SecretLabNAudio.Core.Processors.AudioQueue" />, the
            <see cref="P:SecretLabNAudio.Core.AudioPlayer.SampleProvider" />
            will be replaced with a new queue.
        </remarks>
    </Player>
</doc>
